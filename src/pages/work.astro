---
import Layout from "../layouts/Layout.astro"
import B3Nav from "../components/B3Nav.astro"
import B3Footer from "../components/B3Footer.astro"

const services = [
  {
    title: "Web Applications",
    description: "Full-stack web apps built with modern TypeScript, Next.js, and edge deployment.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M3 9h18M9 21V9" /></svg>`,
  },
  {
    title: "AI Agents & LLM Systems",
    description: "Agentic systems grounded in your data. RAG pipelines, function calling, evals.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M16.3 7.7l-2.1 2.1M7.7 16.3l-2.1 2.1" /></svg>`,
  },
  {
    title: "Mobile Apps",
    description: "Native-feeling iOS and Android apps. Swift, Kotlin, React Native.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="3" /><circle cx="12" cy="18" r="1" /></svg>`,
  },
  {
    title: "Cloud Infrastructure",
    description: "AWS, GCP, and hybrid cloud architectures. Terraform everything.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" /></svg>`,
  },
  {
    title: "Data Platforms",
    description: "ETL, warehousing, streaming. Snowflake, BigQuery, Postgres.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5" /><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3" /></svg>`,
  },
  {
    title: "Internal Tools",
    description: "Dashboards, admin panels, and workflow tools. Built right.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>`,
  },
  {
    title: "Product & UX Design",
    description: "Interaction design, prototyping, and systems thinking.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="15.5" r="2.5" /><circle cx="8.5" cy="15.5" r="2.5" /></svg>`,
  },
  {
    title: "Security Audits",
    description: "Penetration testing, threat modeling, and SOC 2 readiness.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>`,
  },
  {
    title: "Migrations",
    description: "Rails to Next. Heroku to AWS. Mongo to Postgres.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4" /><path d="M3 7h18" /><path d="M7 21l-4-4 4-4" /><path d="M21 17H3" /></svg>`,
  },
]

const caseStudies = [
  {
    slug: "construction-operations",
    client: "Construction Industry",
    description: "A confidential operations platform that replaced a paper-driven workflow with a verified, edge-deployed system the whole org runs on.",
    tag: "Enterprise · Internal tool",
    bg: "#1d1d1f",
    color: "#f5f5f7",
  },
  {
    slug: "travel-marketplace",
    client: "Travel & Tourism",
    description: "A two-sided marketplace with real-time inventory, multi-currency pricing, and automatic operator-side reconciliation.",
    tag: "Marketplace · Two-sided",
    bg: "#f5f5f7",
    color: "#1d1d1f",
  },
  {
    slug: "logistics-platform",
    client: "Logistics",
    description: "An on-demand logistics platform with transparent, geo-priced matching and a mobile-native operator console.",
    tag: "Logistics · On-demand",
    bg: "#0a0a0a",
    color: "#f5f5f7",
  },
]

const techStack = [
  // Languages
  "TypeScript", "JavaScript", "Python", "Java", "Go", "Rust",
  // Runtimes
  "Node.js", "Bun", "Deno",
  // Frameworks (frontend)
  "Next.js", "Astro", "React", "Vue", "SvelteKit",
  // Frameworks (backend)
  "Express", "Hono", "NestJS", "FastAPI", "Spring Boot",
  // UI / Styling
  "Tailwind CSS", "Shadcn UI", "Radix", "Framer Motion", "TanStack Query",
  // Cloudflare platform
  "Cloudflare Workers", "Cloudflare D1", "Cloudflare R2", "Cloudflare KV",
  "Durable Objects", "Workers AI", "Email Workers", "Queues", "Hyperdrive",
  // Databases
  "Postgres", "MySQL", "SQLite", "Redis", "MongoDB",
  // ORMs / Data
  "Drizzle ORM", "Prisma", "Zod",
  // Auth
  "Better Auth", "Clerk", "OAuth 2.0", "JWT",
  // AI / LLM
  "OpenAI", "Anthropic", "Workers AI", "Embeddings", "RAG",
  // Payments / Comms
  "Stripe", "Resend",
  // Build / Deploy
  "OpenNext", "Wrangler", "Turborepo", "Vite", "pnpm",
  // CI / Observability
  "GitHub Actions", "Docker", "Sentry", "PostHog",
  // Testing
  "Vitest", "Playwright",
]
---

<Layout
  title="Work — BitByBit (B3)"
  description="Selected case studies from BitByBit (B3) — confidential client engagements across construction, travel, and logistics. Edge-deployed, AI-augmented, production-grade."
>
  <B3Nav />

  <!-- Hero -->
  <section style="padding-top: 140px; padding-bottom: 40px; padding-left: 22px; padding-right: 22px; text-align: center;">
    <div style="max-width: 980px; margin: 0 auto;">
      <p style="font-size: 17px; font-weight: 600; color: #0071e3; letter-spacing: 0.01em; margin-bottom: 12px;">
        What we build
      </p>
      <h1
        class="b3-display"
        style="font-size: clamp(48px, 7vw, 104px); margin: 0 0 28px;"
      >
        Serious software,
        <br />
        for serious teams.
      </h1>
      <p class="subhead" style="margin-bottom: 0;">
        We design and build custom products across nine disciplines. Every engagement is scoped, fixed, and shipped.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section
    style="max-width: 1200px; margin: 0 auto; padding: 20px 22px 100px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;"
  >
    {services.map((service) => (
      <div
        style="background: #f5f5f7; border-radius: 18px; padding: 32px 28px; min-height: 240px; display: flex; flex-direction: column;"
      >
        <div
          style="width: 44px; height: 44px; border-radius: 10px; background: #1d1d1f; display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 20px; flex-shrink: 0;"
          set:html={service.icon}
        />
        <h2
          style="font-family: var(--font-unbounded), sans-serif; font-size: 19px; font-weight: 700; letter-spacing: -0.03em; margin: 0 0 10px; line-height: 1.2;"
        >
          {service.title}
        </h2>
        <p style="font-size: 15px; line-height: 1.55; color: #6e6e73; margin: 0;">
          {service.description}
        </p>
      </div>
    ))}
  </section>

  <!-- Case studies -->
  <section style="background: #fbfbfd; padding: 100px 22px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <p class="eyebrow-center" style="margin-bottom: 4px;">Selected work</p>
      <h2 class="headline">Things we&apos;ve shipped.</h2>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-top: 48px;"
      >
        {caseStudies.map((study) => (
          <a
            href={`/work/${study.slug}`}
            style={`background: ${study.bg}; color: ${study.color}; border-radius: 18px; padding: 36px; min-height: 320px; display: flex; flex-direction: column; justify-content: space-between; text-decoration: none;`}
          >
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; gap: 12px;">
                <p
                  style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; margin: 0;"
                >
                  {study.client}
                </p>
                <span style={`font-size: 11px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.5; border: 1px solid currentColor; padding: 4px 8px; border-radius: 999px; flex-shrink: 0;`}>
                  {study.tag}
                </span>
              </div>
              <h3
                class="b3-display"
                style="font-size: clamp(20px, 2.2vw, 28px); margin: 0; line-height: 1.2;"
              >
                {study.description}
              </h3>
            </div>
            <span
              style={`font-size: 15px; font-weight: 500; color: ${study.color}; opacity: 0.7; margin-top: 32px; display: inline-block;`}
            >
              Read the case study &rsaquo;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="sec">
    <div class="sec-inner" style="text-align: center;">
      <p class="eyebrow-center" style="margin-bottom: 4px;">Our stack</p>
      <h2 class="headline">The tools we swear by.</h2>
      <div
        style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 32px;"
      >
        {techStack.map((tech) => (
          <span class="badge-light badge">{tech}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA tile -->
  <div class="tile-grid one" style="padding-bottom: 80px;">
    <div class="tile tile-black">
      <h2 class="tile-title">Ready to start?</h2>
      <p class="tile-sub">
        Tell us what you&apos;re building. We&apos;ll scope it, price it, and ship it.
      </p>
      <div class="tile-ctas">
        <a href="/contact" class="btn btn-dark">
          Start a project &rarr;
        </a>
      </div>
    </div>
  </div>

  <B3Footer />
</Layout>
