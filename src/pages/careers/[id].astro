---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import B3Nav from '../../components/B3Nav.astro'
import B3Footer from '../../components/B3Footer.astro'
import { jobs } from '../../lib/jobs'

export function getStaticPaths() {
  return jobs.map((job) => ({ params: { id: job.id }, props: { job } }))
}

const { job } = Astro.props

const benefitsList = [
  'Salary as listed on this posting',
  'Platinum medical, dental, and vision — fully employer-paid',
  '401k with 6% company match, vested from day one',
  'Unlimited PTO with a four-week minimum',
  '$3,000/year learning & development budget',
  'Home-office setup stipend on your first day',
]
---

<Layout
  title={`${job.title} — BitByBit Careers`}
  description={job.summary}
>
  <div class="page-fade">
    <B3Nav />

    <!-- Back link -->
    <div style="padding:60px 22px 20px;">
      <div style="max-width:820px;margin:0 auto;">
        <a
          href="/careers"
          style="color:#6e6e73;font-size:15px;display:inline-flex;align-items:center;gap:4px;"
        >
          ‹ All open roles
        </a>
      </div>
    </div>

    <!-- Job header -->
    <section style="padding:20px 22px 40px;">
      <div style="max-width:820px;margin:0 auto;">
        <p
          style="color:#0071e3;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 12px;"
        >
          {job.team}
        </p>
        <h1
          class="b3-display"
          style="font-size:clamp(40px,6vw,72px);margin:0 0 24px;color:#1d1d1f;"
        >
          {job.title}
        </h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px;">
          <span class="job-pill">{job.location}</span>
          <span class="job-pill">{job.type}</span>
          <span class="job-pill">{job.salary}</span>
        </div>
        <p style="font-size:21px;color:#1d1d1f;line-height:1.45;margin:0 0 36px;letter-spacing:-0.01em;">
          {job.summary}
        </p>
        <a href={`/careers/${job.id}/apply`} class="btn btn-primary btn-lg">
          Apply for this role
        </a>
      </div>
    </section>

    <!-- Job body -->
    <section style="padding:40px 22px 80px;">
      <div style="max-width:820px;margin:0 auto;">

        <!-- About the role -->
        <div style="margin-bottom:48px;">
          <h2 style="font-size:28px;font-weight:600;letter-spacing:-0.025em;margin:0 0 16px;">
            About the role
          </h2>
          <p style="font-size:17px;line-height:1.65;color:#1d1d1f;">{job.about}</p>
        </div>

        <!-- What you'll do -->
        <div style="margin-bottom:48px;">
          <h2 style="font-size:28px;font-weight:600;letter-spacing:-0.025em;margin:0 0 16px;">
            What you&rsquo;ll do
          </h2>
          <ul style="padding-left:20px;margin:0;">
            {job.responsibilities.map((r) => (
              <li style="font-size:17px;line-height:1.65;color:#1d1d1f;margin-bottom:8px;">{r}</li>
            ))}
          </ul>
        </div>

        <!-- What we're looking for -->
        <div style="margin-bottom:48px;">
          <h2 style="font-size:28px;font-weight:600;letter-spacing:-0.025em;margin:0 0 16px;">
            What we&rsquo;re looking for
          </h2>
          <ul style="padding-left:20px;margin:0;">
            {job.requirements.map((r) => (
              <li style="font-size:17px;line-height:1.65;color:#1d1d1f;margin-bottom:8px;">{r}</li>
            ))}
          </ul>
        </div>

        <!-- Nice to have -->
        {job.nice.length > 0 && (
          <div style="margin-bottom:48px;">
            <h2 style="font-size:28px;font-weight:600;letter-spacing:-0.025em;margin:0 0 16px;">
              Nice to have
            </h2>
            <ul style="padding-left:20px;margin:0;">
              {job.nice.map((n) => (
                <li style="font-size:17px;line-height:1.65;color:#1d1d1f;margin-bottom:8px;">{n}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Compensation & benefits -->
        <div style="margin-bottom:48px;">
          <h2 style="font-size:28px;font-weight:600;letter-spacing:-0.025em;margin:0 0 16px;">
            Compensation &amp; benefits
          </h2>
          <ul style="padding-left:20px;margin:0;">
            {benefitsList.map((b) => (
              <li style="font-size:17px;line-height:1.65;color:#1d1d1f;margin-bottom:8px;">{b}</li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- Apply CTA -->
    <section
      style="background:#000;color:#fff;padding:100px 22px;text-align:center;"
    >
      <h2
        class="b3-display"
        style="font-size:clamp(40px,6vw,80px);color:#fff;margin:0 0 20px;"
      >
        Ready to apply?
      </h2>
      <p style="font-size:21px;color:#a1a1a6;margin:0 auto 40px;max-width:480px;line-height:1.4;">
        We review every application personally. Expect to hear from us within five business days.
      </p>
      <a href={`/careers/${job.id}/apply`} class="btn btn-dark btn-lg">
        Apply for this role
      </a>
      <p style="margin-top:20px;font-size:14px;color:#6e6e73;">Takes about 4 minutes.</p>
    </section>

    <B3Footer />
  </div>
</Layout>
